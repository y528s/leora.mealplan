# Copy this file to `.env` and fill in your own values.
#
# `.env` is gitignored — this example file exists so anyone setting the project
# up knows WHICH values they need without ever seeing the real ones.
#
# Both come from your Supabase project: Project Settings -> API
# See SETUP.md step 3.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The Claude API key is deliberately NOT here. It must never be in the app at
# all — it lives on the server instead:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# See SETUP.md step 5.
